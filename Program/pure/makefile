all : split

CCC = g++
CCFLAGS = -O3
CPPFLAGS += -I. -MMD -MP

OBJS = \
	commandline.o \
	main.o \
	Pb_Data.o \
	Split_Bellman_PTVRP.o \
	Split_Bellman_PTVRP_cont.o \
	Split_Bellman_PTVRP_cont_fix.o \
	Split_Linear_PTVRP.o \
	Split_Layered_PTVRP.o \
	Split_Layered_PTVRP_cont.o \
	Split_Layered_PTVRP_cont_fix.o \
	Split_Layered_PTVRP_safe.o

split: $(OBJS)
	$(CCC) $(CCFLAGS) -o split $(OBJS)

%.o: %.cpp
	$(CCC) $(CCFLAGS) $(CPPFLAGS) -c $< -o $@

# header dependencies generated by -MMD
-include $(OBJS:.o=.d)

clean:
	$(RM) split $(OBJS) $(OBJS:.o=.d)
